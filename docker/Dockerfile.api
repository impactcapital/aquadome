FROM python:3.11-slim

WORKDIR /app

# System deps for GDAL/rasterio
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    gdal-bin \
    libgeos-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[geo-full]"

COPY src/ src/

ENV AQUADOME_API_HOST=0.0.0.0
ENV AQUADOME_API_PORT=8000

EXPOSE 8000

CMD ["uvicorn", "aquadome.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
